.gun-status-view.data-v-0fd4b604 {
  display: flex;
  position: relative;
  align-items: center;
  background: #E6F0FF;
  padding-left: 16rpx;
  right: 15rpx;
  z-index: 1;
  padding-right: 2rpx;
}
/* 超充站卡片样式 */
.super-station-card.data-v-0fd4b604 {
  position: relative;
  overflow: hidden;
  /* 确保渐变背景不会超出卡片边界 */
}
/* 超充站背景渐变层（最底层） */
.super-station-background.data-v-0fd4b604 {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(130deg, #FFFFFF 0%, #007AFF 140%);
  z-index: 1;
  /* 最底层 */
  pointer-events: none;
  /* 不阻止点击事件 */
}
/* 超充站右下角文字 */
.super-station-label.data-v-0fd4b604 {
  position: absolute;
  bottom: 12rpx;
  right: 16rpx;
  z-index: 2;
  /* 在背景之上，但在内容之下 */
  pointer-events: none;
  /* 不阻止点击事件 */
}
.super-station-text.data-v-0fd4b604 {
  color: #FFFFFF;
  font-size: 200rpx;
  font-weight: bold;
  font-style: italic;
  opacity: 0.75;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
  /* 添加阴影增强可读性 */
}
/* 确保主要内容在最上层 */
.station-content.data-v-0fd4b604 {
  position: relative;
  z-index: 10;
  /* 确保内容在最上层 */
}
/* 左上角角标（合作/超充/推荐） */
.cooperation-corner-tag.data-v-0fd4b604 {
  position: absolute;
  top: 0;
  left: 0;
  width: 120rpx;
  height: 36rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  line-height: 36rpx;
  transform: rotate(-45deg) translate(-30rpx, 20rpx);
  transform-origin: left top;
  font-weight: 500;
  z-index: 2;
}
/* 距离（右上角小字） */
.distance-corner-tag.data-v-0fd4b604 {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  font-size: 22rpx;
  color: #007AFF;
  /* 绿色 */
  background: transparent;
  font-weight: 500;
}
/* 第一行：站点名称与距离 space-between布局 */
.name-distance-row.data-v-0fd4b604 {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-bottom: 16rpx;
}
.name-section.data-v-0fd4b604 {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  /* 允许子元素收缩，配合省略号显示 */
}
.cooperation-tag-distance-section.data-v-0fd4b604 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 4rpx;
  padding-right: 16rpx;
  padding-bottom: 8rpx;
}
.cooperation-tag-section.data-v-0fd4b604 {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding-right: 16rpx;
  padding-bottom: 8rpx;
}
.discount-tag.data-v-0fd4b604 {
  background: #FF6F6B;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  display: inline-block;
}
.cooperation-tag.data-v-0fd4b604 {
  background: #FBA954;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  display: inline-block;
}
.gun-type-tag.data-v-0fd4b604 {
  background: #007AFF;
  color: #fff;
  font-size: 24rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  display: inline-block;
  z-index: 2;
}
.station-name.data-v-0fd4b604 {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.2;
  /* 不换行，超出部分用省略号隐藏 */
}
.distance-section .distance-text.data-v-0fd4b604 {
  font-size: 26rpx;
  color: #5aaaff;
  font-weight: bold;
}
/* 第二行：价格与是否自营 space-between布局 */
.price-operate-row.data-v-0fd4b604 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.price-section.data-v-0fd4b604 {
  display: flex;
  align-items: baseline;
}
.price-section .price-symbol.data-v-0fd4b604 {
  font-size: 36rpx;
  color: #FF6B6B;
  font-weight: bold;
}
.price-section .price-value.data-v-0fd4b604 {
  font-size: 36rpx;
  color: #FF6B6B;
  font-weight: bold;
  margin: 0 4rpx;
}
.price-section .price-unit.data-v-0fd4b604 {
  font-size: 24rpx;
  color: #FF6B6B;
}
.price-section .original-price.data-v-0fd4b604 {
  display: flex;
  align-items: baseline;
  margin-left: 16rpx;
}
.price-section .original-price .original-price-symbol.data-v-0fd4b604,
.price-section .original-price .original-price-value.data-v-0fd4b604 {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}
.price-section .original-price .original-price-symbol.data-v-0fd4b604 {
  margin-right: 2rpx;
}
/* 第三行：充电桩状态 */
.gun-status-row.data-v-0fd4b604 {
  display: flex;
  gap: 32rpx;
  margin-bottom: 12rpx;
  /* 当同时拥有超充和快充时，使用space-between布局 */
}
.gun-status-row.gun-space-between.data-v-0fd4b604 {
  justify-content: space-between;
  gap: 0;
}
.gun-group.data-v-0fd4b604 {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.gun-icon.data-v-0fd4b604 {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
}
.gun-icon.gun-icon-super.data-v-0fd4b604 {
  background: #1890ff;
}
.gun-icon.gun-icon-fast.data-v-0fd4b604 {
  background: #fa8c16;
}
.gun-view.data-v-0fd4b604 {
  display: flex;
  align-items: flex-end;
}
.gun-view .free-gun-text.data-v-0fd4b604 {
  font-size: 22rpx;
  font-weight: bold;
  margin-right: 4rpx;
}
.gun-view .total-gun-text.data-v-0fd4b604 {
  font-size: 22rpx;
  font-weight: bold;
  color: #6e6c6c;
  margin-left: 4rpx;
}
.gun-view .separator.data-v-0fd4b604 {
  font-size: 16rpx;
  color: #494646;
}
/* 通知栏 */
.notice-bar.data-v-0fd4b604 {
  display: flex;
  align-items: flex-start;
  opacity: 0.75;
  background: #f0f5ff;
  border-radius: 6rpx;
  padding: 8rpx 8rpx;
  gap: 6rpx;
  margin-top: 10rpx;
}
.notice-bar .notice-icon.data-v-0fd4b604 {
  font-size: 20rpx;
  color: #1890ff;
  margin-top: 2rpx;
  /* 微调图标位置 */
  flex-shrink: 0;
  /* 防止图标被压缩 */
}
.notice-bar .notice-text.data-v-0fd4b604 {
  font-size: 22rpx;
  color: #000;
  flex: 1;
  line-height: 1.4;
  /* 限制显示两行，超出部分省略 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  /* 标准属性，提高兼容性 */
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}
