.price-info-container.data-v-353c7449 {
  background: #F2F8FF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}
/* 头部：充电类型和时间 */
.price-header.data-v-353c7449 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.charge-type-tag.data-v-353c7449 {
  background: #ff6b00;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  min-width: 48rpx;
  text-align: center;
}
.charge-type-tag .charge-type-text.data-v-353c7449 {
  font-size: 22rpx;
  font-weight: bold;
  color: #ffffff;
}
.time-range .time-text.data-v-353c7449 {
  font-size: 22rpx;
  color: #3C9CFF;
}
/* 当前价格区域 */
.current-price-section.data-v-353c7449 {
  margin-bottom: 12rpx;
}
.current-price-label.data-v-353c7449 {
  font-size: 24rpx;
  color: #666666;
  margin-right: 16rpx;
}
.price-display.data-v-353c7449 {
  display: inline-flex;
  align-items: baseline;
}
.price-display .price-symbol.data-v-353c7449 {
  font-size: 28rpx;
  color: #5AAAFF;
  font-weight: bold;
}
.price-display .price-value.data-v-353c7449 {
  font-size: 36rpx;
  color: #5AAAFF;
  font-weight: bold;
  margin: 0 4rpx;
}
.price-display .price-unit.data-v-353c7449 {
  font-size: 24rpx;
  color: #5AAAFF;
  font-weight: 500;
}
.price-display .original-price.data-v-353c7449 {
  display: flex;
  align-items: baseline;
  margin-left: 16rpx;
}
.price-display .original-price .original-price-symbol.data-v-353c7449,
.price-display .original-price .original-price-value.data-v-353c7449 {
  font-size: 20rpx;
  color: #999;
  text-decoration: line-through;
}
.price-display .original-price .original-price-symbol.data-v-353c7449 {
  margin-right: 2rpx;
}
/* 费用明细 */
.price-detail .detail-text.data-v-353c7449 {
  font-size: 22rpx;
  color: #999999;
  line-height: 1.4;
}
.gun-count-container.data-v-353c7449 {
  margin-left: 10rpx;
}
.gun-count-container .free-gun-count.data-v-353c7449 {
  font-size: 24rpx;
  font-weight: 500;
  transition: color 0.3s ease;
}
.gun-count-container .gun-count.data-v-353c7449 {
  font-size: 22rpx;
  color: #999999;
}
/* 空闲枪数量颜色状态 */
.gun-count-red.data-v-353c7449 {
  color: #f56c6c !important;
  /* 红色：空闲枪数量为0 */
}
.gun-count-yellow.data-v-353c7449 {
  color: #e6a23c !important;
  /* 黄色：其他情况 */
}
.gun-count-green.data-v-353c7449 {
  color: #67c23a !important;
  /* 绿色：空闲枪数量>=5或>=总数一半 */
}
