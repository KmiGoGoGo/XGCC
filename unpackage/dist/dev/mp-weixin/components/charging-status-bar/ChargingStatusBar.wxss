.charging-status-bar.data-v-cb2f55a8 {
  position: fixed;
  z-index: 9999;
  /* 提高层级，确保在最上层 */
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
  /* 增强阴影效果 */
  padding: 24rpx;
  width: calc(100vw - 0px);
  /* 设置固定宽度 */
  max-width: 89%;
  /* 最大宽度限制 */
  border: 2rpx solid #f0f0f0;
  /* 添加边框 */
  transition: box-shadow 0.3s ease;
  /* 添加阴影过渡效果 */
  /* 拖拽时的样式 */
}
.charging-status-bar.data-v-cb2f55a8:active {
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.25);
  transform: scale(1.02);
}
.drag-indicator.data-v-cb2f55a8 {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: #007AFF;
  letter-spacing: 2rpx;
  -webkit-user-select: none;
          user-select: none;
  pointer-events: auto;
  cursor: pointer;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background-color: rgba(0, 122, 255, 0.1);
}
.status-container.data-v-cb2f55a8 {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 16rpx;
  min-height: 120rpx;
}
.status-item.data-v-cb2f55a8 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
}
.top-left.data-v-cb2f55a8 {
  grid-column: 1;
  grid-row: 1;
}
.top-right.data-v-cb2f55a8 {
  grid-column: 2;
  grid-row: 1;
}
.bottom-left.data-v-cb2f55a8 {
  grid-column: 1;
  grid-row: 2;
}
.bottom-right.data-v-cb2f55a8 {
  grid-column: 2;
  grid-row: 2;
}
.label.data-v-cb2f55a8 {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}
.value.data-v-cb2f55a8 {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}
/* 水平分割线 */
.divider-horizontal.data-v-cb2f55a8 {
  position: absolute;
  top: 50%;
  left: 8rpx;
  right: 8rpx;
  height: 1rpx;
  background-color: #e0e0e0;
  transform: translateY(-50%);
}
/* 垂直分割线 */
.divider-vertical.data-v-cb2f55a8 {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 50%;
  width: 1rpx;
  background-color: #e0e0e0;
  transform: translateX(-50%);
}
/* 特殊值样式 */
.status-item .value.charging.data-v-cb2f55a8 {
  color: #07c160;
}
.status-item .value.warning.data-v-cb2f55a8 {
  color: #ff9500;
}
.status-item .value.error.data-v-cb2f55a8 {
  color: #ff3b30;
}
