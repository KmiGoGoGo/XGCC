
.floating-reminder.data-v-909ddfee {
    position: fixed;
    bottom: calc(170rpx + env(safe-area-inset-bottom));
    left: 32rpx;
    right: 32rpx;
    z-index: 10000;
    background: #FFFFFF;
    border-radius: 24rpx;
    padding: 24rpx 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
    border: 1rpx solid rgba(0, 0, 0, 0.05);
    animation: slideUp-909ddfee 0.3s ease-out;
}
.reminder-content.data-v-909ddfee {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 750rpx;
}
.reminder-text.data-v-909ddfee {
    color: #333333;
    font-size: 28rpx;
    font-weight: 400;
}
.reminder-action.data-v-909ddfee {
    color: #007AFF;
    font-size: 28rpx;
    font-weight: 500;
}

/* 动画效果 */
@keyframes slideUp-909ddfee {
from {
        transform: translateY(100%);
        opacity: 0;
}
to {
        transform: translateY(0);
        opacity: 1;
}
}

/* 点击效果 */
.floating-reminder.data-v-909ddfee:active {
    opacity: 0.8;
    transition: opacity 0.1s ease;
}
