page {
  height: 100%;
  /* 从白色到 #F3F3F3 的快速渐变背景 */
  background: #F3F4F6;
}
.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding-left: 20rpx;
  padding-right: 20rpx;
  /* 从白色到 #F3F3F3 的快速渐变背景 */
  background: #F3F3F3;
}
/* 自定义导航栏样式 */
.navbar-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
}
.city-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
.navbar-center {
  flex: 1;
  margin: 0 20rpx;
}
.navbar-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
}
.filter-text {
  color: #fff;
  font-size: 26rpx;
}
.swiper-view {
  background-color: #ffffff;
  margin-top: 20rpx;
  border-radius: 20rpx;
}
.header-image2 {
  width: 100%;
  height: 200rpx;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}
.swiper-banner {
  width: 100%;
  height: 200rpx;
  position: relative;
  z-index: 2;
  border-radius: 20rpx;
  overflow: hidden;
}
.swiper-item-images {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}
/* 可滚动内容区域 */
.content-container {
  flex: 1;
  overflow-y: auto;
  /* uv-navbar组件会自动处理占位，不需要手动设置margin-top */
}
/* 底部安全区域 */
.bottom-safe-area {
  height: calc(140rpx + env(safe-area-inset-bottom));
  background: transparent;
}
.scroll-h {
  width: 750rpx;
  height: 80rpx;
  flex-direction: row;
  white-space: nowrap;
}
.uni-tab-item {
  display: inline-block;
  flex-wrap: nowrap;
  padding-left: 34rpx;
  padding-right: 34rpx;
}
.uni-tab-item-title {
  color: #fff;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  flex-wrap: nowrap;
  white-space: nowrap;
}
.uni-tab-item-title-active {
  color: #FFC0CB;
}
.content {
  margin-top: 100rpx;
}
