.header {
  background-color: #007AFF;
}
/* 筛选弹窗样式 */
.filter-popup-content {
  background-color: #fff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 0;
  max-height: 80vh;
}
.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 16rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.filter-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.filter-content {
  padding: 0 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}
.filter-footer {
  display: flex;
  padding: 24rpx 32rpx 32rpx 32rpx;
  gap: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fff;
}
.reset-btn,
.confirm-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  border: none;
  font-size: 28rpx;
  line-height: 80rpx;
}
.reset-btn {
  background-color: #f5f5f5;
  color: #666;
}
.confirm-btn {
  background-color: #2594FB;
  color: #fff;
}
