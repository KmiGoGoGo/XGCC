
/* 容器样式 */
.login-container.data-v-e4e4508d {
    min-height: 100vh;
    background-color: #E2F5FF;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 0 48rpx;
    box-sizing: border-box;
    font-family: "Noto Sans SC", sans-serif;
}

/* 主要内容区域 */
.main-content.data-v-e4e4508d {
    width: 100%;
    max-width: 640rpx;
    text-align: center;
}

/* 标题区域 */
.title-section.data-v-e4e4508d {
    margin-bottom: 96rpx;
}
.title.data-v-e4e4508d {
    display: block;
    font-size: 48rpx;
    font-weight: bold;
    color: #1f2937;
    margin-bottom: 16rpx;
}
.subtitle.data-v-e4e4508d {
    display: block;
    font-size: 36rpx;
    color: #4b5563;
}

/* 表单区域 */
.form-section.data-v-e4e4508d {
    width: 100%;
}

/* 输入框组 */
.input-group.data-v-e4e4508d {
    margin-bottom: 32rpx;
}
.input-container.data-v-e4e4508d {
    position: relative;
    width: 100%;
}
.input-icon.data-v-e4e4508d {
    position: absolute;
    left: 24rpx;
    top: 50%;
    transform: translateY(-50%);
    font-size: 32rpx;
    color: #9ca3af;
    z-index: 2;
}
.input-field.data-v-e4e4508d {
    width: 100%;
    padding: 24rpx 32rpx 24rpx 80rpx;
    border: 2rpx solid #d1d5db;
    border-radius: 16rpx;
    background-color: #ffffff;
    font-size: 32rpx;
    color: #1f2937;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.3s ease;
}
.input-field.data-v-e4e4508d:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 6rpx rgba(59, 130, 246, 0.1);
}
.input-field.data-v-e4e4508d::-webkit-input-placeholder {
    color: #9ca3af;
}
.input-field.data-v-e4e4508d::placeholder {
    color: #9ca3af;
}

/* 登录按钮 */
.login-button.data-v-e4e4508d {
    width: 100%;
    background-color: #2563eb;
    color: #ffffff;
    font-weight: bold;
    padding: 24rpx 32rpx;
    border-radius: 16rpx;
    margin-bottom: 32rpx;
    transition: background-color 0.3s ease;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
}
.login-button.data-v-e4e4508d:hover {
    background-color: #1d4ed8;
}
.login-button-text.data-v-e4e4508d {
    color: #ffffff;
    font-size: 32rpx;
    font-weight: bold;
    display: block;
}

/* 注册链接 */
.register-link.data-v-e4e4508d {
    text-align: center;
}
.register-text.data-v-e4e4508d {
    color: #2563eb;
    font-size: 28rpx;
    text-decoration: underline;
    cursor: pointer;
}
.register-text.data-v-e4e4508d:hover {
    color: #1d4ed8;
}

/* 底部协议区域 */
.agreement-section.data-v-e4e4508d {
    position: fixed;
    bottom: 64rpx;
    left: 48rpx;
    right: 48rpx;
    width: calc(100% - 96rpx);
    max-width: 640rpx;
    margin: 0 auto;
}
.agreement-container.data-v-e4e4508d {
    display: flex;
    justify-content: center;
    align-items: center;
}
.checkbox-container.data-v-e4e4508d {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
}
.checkbox.data-v-e4e4508d {
    width: 32rpx;
    height: 32rpx;
    border: 2rpx solid #d1d5db;
    border-radius: 6rpx;
    margin-right: 16rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #f3f4f6;
    flex-shrink: 0;
    transition: all 0.3s ease;
}
.checkbox.checked.data-v-e4e4508d {
    background-color: #2563eb;
    border-color: #2563eb;
}
.checkmark.data-v-e4e4508d {
    color: #ffffff;
    font-size: 20rpx;
    font-weight: bold;
}
.agreement-text.data-v-e4e4508d {
    color: #6b7280;
    font-size: 24rpx;
    line-height: 1.5;
}
.agreement-link.data-v-e4e4508d {
    color: #2563eb;
    text-decoration: underline;
    cursor: pointer;
}
.agreement-link.data-v-e4e4508d:hover {
    color: #1d4ed8;
}
