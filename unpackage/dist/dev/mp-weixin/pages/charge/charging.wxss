
.lottie-container.data-v-c5192987 {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #288EEE;
    z-index: 998;
    opacity: 1;
}
.no-animation.data-v-c5192987 {
    opacity: 0;
    background-color: #E2F5FF;
    pointer-events: none;
}
.lottie-animation1.data-v-c5192987 {
    opacity: 0;
    /* background-color: #E2F5FF; */
    pointer-events: none;
    transition:opacity 4s ease-in-out;
}
.lottie-animation2.data-v-c5192987 {
    background-color: #E2F5FF;
    pointer-events: none;
    /* transition: background-color 1s ease; */
}
.page-container.data-v-c5192987 {
    height: 100vh;
    width: 100vw;
    /* display: flex;
    justify-content: center;
    align-items: center; */
    background-color: #E2F5FF;
    position: relative;
    padding: 0 32rpx;
    box-sizing: border-box;
}

/* 固定居中显示的文字容器 */
.loading-text-container.data-v-c5192987 {
    position: fixed;
    top: 85%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: transparent;
    z-index: 998;
}
/* 白色文字样式 */
.loading-text.data-v-c5192987 {
    color: #FFFFFF;
}
.back-icon.data-v-c5192987 {
    font-size: 48rpx;
    color: #333;
    font-weight: bold;
}
.nav-title.data-v-c5192987 {
    font-size: 36rpx;
    color: #333;
    font-weight: 500;
}
.info-icon.data-v-c5192987 {
    width: 36rpx;
    height: 36rpx;
    border: 2rpx solid #333;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 24rpx;
    color: #333;
}

/* 充电站信息 */
.station-info.data-v-c5192987 {
    text-align: center;
    padding-top: 20rpx;
    margin-bottom: 60rpx;
}
.station-name.data-v-c5192987 {
    display: block;
    font-size: 32rpx;
    color: #333;
    font-weight: bold;
    margin-bottom: 16rpx;
}
.station-gun.data-v-c5192987 {
    display: block;
    font-size: 24rpx;
    color: #666;
}

/* 电量圆环 */
.battery-circle.data-v-c5192987 {
    display: flex;
    justify-content: center;
    margin-bottom: 60rpx;
}
.circle-container.data-v-c5192987 {
    width: 320rpx;
    height: 320rpx;
    border-radius: 50%;
    background: #FFFFFF;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
    position: relative;
}
.circle-container.data-v-c5192987::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #4A90E2 0%, #4A90E2 78%, #E8F4FD 78%, #E8F4FD 100%);
    padding: 12rpx;
    box-sizing: border-box;
    mask: radial-gradient(farthest-side, transparent calc(100% - 12rpx), white calc(100% - 12rpx));
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 12rpx), white calc(100% - 12rpx));
}
.battery-percent.data-v-c5192987 {
    font-size: 88rpx;
    font-weight: bold;
    color: #4A90E2;
    /* z-index: 1; */
}
.battery-percent-unit.data-v-c5192987 {
    font-size: 48rpx;
    color: #4A90E2;
}
/* 车牌号和时间 */
.car-info.data-v-c5192987 {
    text-align: center;
    margin-bottom: 40rpx;
}
.car-number.data-v-c5192987 {
    display: block;
    font-size: 40rpx;
    color: #333;
    font-weight: 700;
    margin-bottom: 16rpx;
}
.charge-time.data-v-c5192987 {
    display: block;
    font-size: 24rpx;
    color: #666;
}

/* 统计卡片 */
.stats-card.data-v-c5192987 {
    background: #FFFFFF;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 40rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.price-info.data-v-c5192987 {
    margin-bottom: 32rpx;
}
.price-label.data-v-c5192987 {
    font-size: 28rpx;
    color: #666;
}
.price-value.data-v-c5192987 {
    font-size: 36rpx;
    font-weight: bold;
    color: #4A90E2;
}
.stats-row.data-v-c5192987 {
    display: flex;
    justify-content: space-between;
    margin-bottom: 48rpx;
}
.stats-row.data-v-c5192987:last-child {
    margin-bottom: 0;
}
.stat-item.data-v-c5192987 {
    flex: 1;
    text-align: center;
}
.stat-value.data-v-c5192987 {
    display: block;
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
}
.stat-label.data-v-c5192987 {
    display: block;
    font-size: 24rpx;
    color: #999;
}

/* 停止充电按钮 */
.stop-button.data-v-c5192987 {
    background: #4A90E2;
    border-radius: 48rpx;
    height: 96rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 60rpx;
    width: 100%;
    max-width: 600rpx;
    margin-top: 20rpx;
}
.stop-text.data-v-c5192987 {
    color: #FFFFFF;
    font-size: 32rpx;
    font-weight: 500;
}

