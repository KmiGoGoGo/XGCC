
.page-container.data-v-c82d6e48 {
    height: 100vh;
    width: 100vw;
    background: #E2F5FF;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 0 32rpx;
    box-sizing: border-box;
    position: relative;
}

/* 消息容器 */
.message-container.data-v-c82d6e48 {
    text-align: center;
    margin-bottom: 120rpx;
    animation: fadeInUp-c82d6e48 0.8s ease-out;
}
.main-message.data-v-c82d6e48 {
    display: block;
    font-size: 36rpx;
    color: #3B82F6;
    font-weight: bold;
    margin-bottom: 24rpx;
    text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}
.sub-message.data-v-c82d6e48 {
    display: block;
    font-size: 32rpx;
    color: #3B82F6;
    font-weight: 400;
}

/* 倒计时圆环 */
.countdown-circle.data-v-c82d6e48 {
    display: flex;
    justify-content: center;
    margin-bottom: 120rpx;
    animation: fadeInScale-c82d6e48 0.8s ease-out 0.2s both;
}
.circle-container.data-v-c82d6e48 {
    width: 400rpx;
    height: 400rpx;
    border-radius: 50%;
    background: #FFFFFF;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.2);
    position: relative;
    overflow: hidden;
}
.circle-container.data-v-c82d6e48::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: conic-gradient(
        from 0deg, 
        #3B82F6 0%, 
        #3B82F6 var(--progress, 100%), 
        #f0f0f0 var(--progress, 100%), 
        #f0f0f0 100%
    );
    padding: 16rpx;
    box-sizing: border-box;
    mask: radial-gradient(farthest-side, transparent calc(100% - 16rpx), white calc(100% - 16rpx));
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 16rpx), white calc(100% - 16rpx));
    transition: background 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform: rotate(-90deg); /* 从顶部开始 */
}
.countdown-text.data-v-c82d6e48 {
    font-size: 96rpx;
    font-weight: bold;
    color: #3B82F6;
    z-index: 1;
    position: relative;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}
.countdown-unit.data-v-c82d6e48 {
    font-size: 48rpx;
    color: #3B82F6;
    margin-left: 8rpx;
}

/* 状态信息 */
.status-info.data-v-c82d6e48 {
    text-align: center;
    animation: fadeInUp-c82d6e48 0.8s ease-out 0.4s both;
}
.status-text.data-v-c82d6e48 {
    font-size: 32rpx;
    color: #3B82F6;
    position: relative;
}
.status-text.data-v-c82d6e48::after {
    content: '';
    display: inline-block;
    width: 8rpx;
    height: 8rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.8);
    margin-left: 16rpx;
    animation: blink-c82d6e48 1.5s infinite;
}

/* 动画效果 */
@keyframes fadeInUp-c82d6e48 {
from {
        opacity: 0;
        transform: translateY(60rpx);
}
to {
        opacity: 1;
        transform: translateY(0);
}
}
@keyframes fadeInScale-c82d6e48 {
from {
        opacity: 0;
        transform: scale(0.8);
}
to {
        opacity: 1;
        transform: scale(1);
}
}
@keyframes blink-c82d6e48 {
0%, 50% {
        opacity: 1;
}
51%, 100% {
        opacity: 0.3;
}
}

/* 倒计时数字变化时的缩放动画 */
.countdown-text.data-v-c82d6e48 {
    animation: countdownPulse-c82d6e48 1s ease-in-out infinite;
}
@keyframes countdownPulse-c82d6e48 {
0%, 100% {
        transform: scale(1);
}
50% {
        transform: scale(1.05);
}
}

/* 移除了警告动画相关样式 */
