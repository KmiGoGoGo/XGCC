.page-container.data-v-0a6fd328 {
  min-height: 100vh;
  background-color: #eff6ff;
  padding-bottom: 120rpx;
}
.page-container.no-payment-btn.data-v-0a6fd328 {
  padding-bottom: 40rpx;
}
/* 头部导航 */
.header.data-v-0a6fd328 {
  background-color: #eff6ff;
  padding: 20rpx 32rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
}
.nav-bar.data-v-0a6fd328 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}
.nav-back.data-v-0a6fd328 {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title.data-v-0a6fd328 {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
}
.nav-placeholder.data-v-0a6fd328 {
  width: 64rpx;
}
.sub-title.data-v-0a6fd328 {
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  margin-top: 16rpx;
}
/* 内容容器 */
.content-container.data-v-0a6fd328 {
  padding: 0 32rpx;
}
/* 统计卡片 */
.stats-card.data-v-0a6fd328 {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.stats-row.data-v-0a6fd328 {
  display: flex;
  justify-content: space-around;
  margin-bottom: 48rpx;
}
.stat-item.data-v-0a6fd328 {
  text-align: center;
}
.stat-value.data-v-0a6fd328 {
  font-size: 60rpx;
  font-weight: bold;
  color: #1f2937;
  line-height: 1.2;
}
.stat-value.primary-color.data-v-0a6fd328 {
  color: #2563eb;
}
.stat-unit.data-v-0a6fd328 {
  font-size: 32rpx;
  font-weight: normal;
}
.stat-label.data-v-0a6fd328 {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 16rpx;
}
.divider.data-v-0a6fd328 {
  height: 2rpx;
  background-color: #f3f4f6;
  margin-bottom: 48rpx;
}
/* 详细信息列表 */
.detail-list .detail-item.data-v-0a6fd328 {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
  font-size: 28rpx;
}
.detail-list .detail-item.data-v-0a6fd328:last-child {
  margin-bottom: 0;
}
.detail-list .detail-label.data-v-0a6fd328 {
  color: #6b7280;
  flex-shrink: 0;
}
.detail-list .detail-value.data-v-0a6fd328 {
  text-align: right;
  color: #1f2937;
  font-weight: 500;
  flex: 1;
  margin-left: 32rpx;
}
.detail-list .detail-value.billing-detail.data-v-0a6fd328 {
  white-space: pre-line;
  line-height: 1.5;
}
.detail-list .copy-btn.data-v-0a6fd328 {
  color: #2563eb;
  font-weight: 600;
  margin-left: 16rpx;
}
/* 费用说明卡片 */
.fee-card.data-v-0a6fd328 {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.fee-header.data-v-0a6fd328 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 48rpx;
}
.fee-title.data-v-0a6fd328 {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
}
.status-badge.data-v-0a6fd328 {
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}
.status-badge.status-unpaid.data-v-0a6fd328 {
  background-color: #fed7aa;
  color: #ea580c;
}
.status-badge.status-paid.data-v-0a6fd328 {
  background-color: #d1fae5;
  color: #059669;
}
.fee-list .fee-item.data-v-0a6fd328 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  font-size: 28rpx;
}
.fee-list .fee-item.data-v-0a6fd328:last-child {
  margin-bottom: 0;
}
.fee-list .fee-label.data-v-0a6fd328 {
  color: #6b7280;
}
.fee-list .fee-amount.data-v-0a6fd328 {
  font-size: 36rpx;
  font-weight: bold;
}
.fee-list .fee-amount.primary-color.data-v-0a6fd328 {
  color: #2563eb;
}
.fee-list .fee-value.data-v-0a6fd328 {
  color: #1f2937;
}
/* 费用疑问 */
.question-section.data-v-0a6fd328 {
  text-align: center;
  margin-bottom: 48rpx;
}
.question-btn.data-v-0a6fd328 {
  display: inline-flex;
  align-items: center;
  font-size: 28rpx;
  color: #6b7280;
}
.question-text.data-v-0a6fd328 {
  margin-left: 8rpx;
}
/* 底部支付按钮 */
.bottom-payment.data-v-0a6fd328 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #eff6ff;
  border-top: 2rpx solid #e5e7eb;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.payment-container.data-v-0a6fd328 {
  max-width: 686rpx;
  margin: 0 auto;
}
.payment-btn.data-v-0a6fd328 {
  width: 100%;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  padding: 24rpx;
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(37, 99, 235, 0.3);
  transition: all 0.3s ease;
}
.payment-btn.data-v-0a6fd328:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.3);
}
.primary-color.data-v-0a6fd328 {
  color: #2563eb;
}
