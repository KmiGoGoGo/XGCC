
page {
  min-height: 100vh;
  background-color: #F0F7FF;
  font-family: 'PingFang SC', sans-serif;
}



/* 页面主容器 */
.page-container.data-v-391493a6 {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 16rpx;
  background-color: #F0F7FF;
  position: relative;
}

/* 内容包装器 */
.content-wrapper.data-v-391493a6 {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  /* 底部安全区域：按钮高度88rpx + 上下padding 64rpx + 额外安全间距24rpx = 176rpx */
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

/* 状态显示区域 */
.status-section.data-v-391493a6 {
  text-align: center;
  padding: 48rpx 0;
}
.status-icon.data-v-391493a6 {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  background-color: rgba(0, 122, 255, 0.2);
  border-radius: 50%;
  margin-bottom: 32rpx;
}
.status-icon .material-icons.data-v-391493a6 {
  color: #007AFF;
  font-size: 120rpx;
}
.status-title.data-v-391493a6 {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #1C1C1E;
  margin-bottom: 16rpx;
}
.status-subtitle.data-v-391493a6 {
  display: block;
  font-size: 28rpx;
  color: #6B7280;
  margin-top: 16rpx;
}
.highlight-text.data-v-391493a6 {
  font-weight: 600;
  color: #007AFF;
}

/* 信息卡片 */
.info-card.data-v-391493a6 {
  background-color: #FFFFFF;
  padding: 48rpx;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
}
.card-title.data-v-391493a6 {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #1C1C1E;
  margin-bottom: 32rpx;
}

/* 信息列表 */
.info-list.data-v-391493a6 {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  font-size: 28rpx;
}
.info-item.data-v-391493a6 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.info-label.data-v-391493a6 {
  color: #6B7280;
}
.info-value-group.data-v-391493a6 {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.info-value.data-v-391493a6 {
  color: #1C1C1E;
  font-weight: 500;
}
.copy-btn.data-v-391493a6 {
  color: #007AFF;
  font-size: 24rpx;
  font-weight: 600;
  background: none;
  border: none;
  padding: 0;
}
.amount-group.data-v-391493a6 {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.amount-value.data-v-391493a6 {
  color: #1C1C1E;
  font-weight: bold;
  font-size: 36rpx;
}
.help-icon.data-v-391493a6 {
  color: #6B7280;
  font-size: 32rpx;
}

/* 说明列表 */
.explanation-list.data-v-391493a6 {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  font-size: 28rpx;
  color: #6B7280;
}
.explanation-item.data-v-391493a6 {
  display: block;
}
.explanation-highlight.data-v-391493a6 {
  font-weight: 600 !important;
  color: #1C1C1E !important;
}

/* 帮助链接 */
.help-link.data-v-391493a6 {
  background-color: #FFFFFF;
  padding: 32rpx;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-decoration: none;
  margin-bottom: 24rpx;
}
.help-title.data-v-391493a6 {
  display: block;
  font-weight: bold;
  color: #1C1C1E;
}
.help-subtitle.data-v-391493a6 {
  display: block;
  font-size: 28rpx;
  color: #6B7280;
  margin-top: 8rpx;
}
.help-arrow.data-v-391493a6 {
  color: #6B7280;
}

/* 联系客服 */
.contact-section.data-v-391493a6 {
  text-align: center;
  margin-top: 48rpx;
  /* 最后一个元素，添加额外的底部边距确保不被按钮遮挡 */
  margin-bottom: 32rpx;
}
.contact-link.data-v-391493a6 {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: 500;
  text-decoration: none;
}

/* 底部按钮区域 */
.bottom-section.data-v-391493a6 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background-color: #F0F7FF;
  z-index: 100;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

/* 移除了旧的home-btn样式，现在使用uv-button组件 */

/* Material Icons 字体 */
.material-icons.data-v-391493a6 {
  font-family: 'Material Icons';
  font-weight: normal;
  font-style: normal;
  font-size: 48rpx;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  font-feature-settings: 'liga';
  -webkit-font-feature-settings: 'liga';
  -webkit-font-smoothing: antialiased;
}

/* 深色模式支持 */
@media (prefers-color-scheme: dark) {
page.data-v-391493a6 {
    background-color: #1C1C1E;
}
.page-container.data-v-391493a6 {
    background-color: #1C1C1E;
}
.info-card.data-v-391493a6 {
    background-color: #2C2C2E;
}
.help-link.data-v-391493a6 {
    background-color: #2C2C2E;
}
.status-title.data-v-391493a6,
  .card-title.data-v-391493a6,
  .info-value.data-v-391493a6,
  .amount-value.data-v-391493a6,
  .explanation-highlight.data-v-391493a6,
  .help-title.data-v-391493a6 {
    color: #000;
}
.status-subtitle.data-v-391493a6,
  .info-label.data-v-391493a6,
  .help-icon.data-v-391493a6,
  .explanation-list.data-v-391493a6,
  .help-subtitle.data-v-391493a6,
  .help-arrow.data-v-391493a6 {
    color: #A0A0A0;
}
.bottom-section.data-v-391493a6 {
    background-color: #1C1C1E;
    box-shadow: 0 -4rpx 20rpx rgba(255, 255, 255, 0.1);
}
}
