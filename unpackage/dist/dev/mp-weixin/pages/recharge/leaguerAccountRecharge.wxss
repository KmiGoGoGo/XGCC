/* 快捷金额网格 */
.amount-grid.data-v-ae64704a {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32rpx;
    margin-bottom: 64rpx;
}
.amount-card.data-v-ae64704a {
    position: relative;
    background: #FFFFFF;
    border-radius: 24rpx;
    padding: 32rpx;
    text-align: center;
    cursor: pointer;
    border: 2rpx solid transparent;
    transition: all 0.2s ease;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.amount-card.data-v-ae64704a:hover {
    border-color: #007AFF;
}
.amount-card.selected.data-v-ae64704a {
    border-color: #007AFF;
    box-shadow: 0 8rpx 32rpx rgba(0, 122, 255, 0.2);
}
.amount-card.special.data-v-ae64704a {
    position: relative;
}
.special-tag.data-v-ae64704a {
    position: absolute;
    top: 0;
    left: 0;
    background: rgba(0, 122, 255, 0.1);
    color: #007AFF;
    font-size: 24rpx;
    font-weight: 600;
    padding: 8rpx 16rpx;
    border-top-left-radius: 24rpx;
    border-bottom-right-radius: 24rpx;
}
.amount-display.data-v-ae64704a {
