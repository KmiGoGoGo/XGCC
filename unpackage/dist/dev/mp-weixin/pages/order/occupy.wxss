
.occupy-order-container.data-v-18a8df7f {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 16rpx;
}
.order-list.data-v-18a8df7f {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.order-card.data-v-18a8df7f {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.card-header.data-v-18a8df7f {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
}
.station-name.data-v-18a8df7f {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.order-status.data-v-18a8df7f {
  font-size: 28rpx;
}
.status-unpaid.data-v-18a8df7f {
  color: #ff976a; /* 橙色 */
}
.status-paid.data-v-18a8df7f {
  color: #007AFF; /* 绿色 */
}
.card-body.data-v-18a8df7f {
  padding: 16rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}
.info-line.data-v-18a8df7f {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
}
.info-line .amount.data-v-18a8df7f {
  color: #ff4d4f;
  font-weight: bold;
}
.subtitle.data-v-18a8df7f {
  font-size: 24rpx;
  color: #999;
}
.card-footer.data-v-18a8df7f {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: 16rpx;
}
.actions.data-v-18a8df7f {
  display: flex;
  gap: 16rpx;
}
.action-btn.data-v-18a8df7f {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  border: 1rpx solid;
}
.btn-secondary.data-v-18a8df7f {
  color: #666;
  border-color: #ccc;
}
.btn-primary.data-v-18a8df7f {
  background-color: #007AFF;
