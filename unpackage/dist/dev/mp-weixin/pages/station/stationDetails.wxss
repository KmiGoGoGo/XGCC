
.page-container {
  background-color: #f6f6f6;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
.main-content {
  flex: 1;
  overflow-y: auto;
  /* 移除原来的底部padding，使用安全区域替代 */
}

/* 底部安全区域 */
.bottom-safe-area {
  height: calc(120rpx + env(safe-area-inset-bottom));
  background: transparent;
}

/* 顶部卡片 */
.station-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}
.station-images-container {
  padding: 20rpx 0 0 0;
}
.image-scroll-list {

  display: flex;

  flex-direction: row;
  padding: 0 20rpx;
}
.image-item {
  margin-right: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

/* .image-item:last-child {
  margin-right: 20rpx;
} */
.station-image {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  /* 添加阴影效果 */
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}
.no-image-placeholder {
  height: 150rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
  margin: 0 20rpx;
}
.no-image-placeholder text {
  color: #999;
  font-size: 28rpx;
}
.station-info {
  padding: 20rpx;
}
.station-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.station-address-distance {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.station-address {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  max-width: 80%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.station-distance {
  font-size: 24rpx;
  color: #007AFF;
}

/* 卡片通用 */
.card {
  background: #fff;
  margin: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}
.card-header {
  font-weight: bold;
  font-size: 28rpx;
  margin-bottom: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-body {
  flex-wrap: wrap;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  margin: 10rpx 0;
}

/* 费用信息样式已移至PriceInfo组件 */

/* 按钮 */
.mini-btn {
  font-size: 24rpx;
  background: #007AFF;
  color: #fff;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.service-btn {
  width: 100%;
  background: #fff;
  border: 1px solid #007AFF;
  color: #007AFF;
  padding: 20rpx;
  border-radius: 12rpx;
}

/* 底部扫码充电 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 6rpx rgba(0, 0, 0, 0.05);
  z-index: 999;
  /* 适配底部安全区域 */
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.charge-btn {
  width: 100%;
  background: #007AFF;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 20rpx;
  border-radius: 50%;
}

/* 停车费折叠组件样式 */
.collapse-wrapper {
  margin-top: 10rpx;
  display: flex;
  flex: 1;
  justify-content: space-between;
}
.collapse-title {
  margin-left: 5rpx;
  font-size: 24rpx;
  color: #999;
  /* 斜体 */
  font-style: italic;
  /* 下划线 */
  text-decoration: underline;
  z-index: 10;
}
.collapse-header {
  display: flex;
  flex: 1;
  align-items: center;
  cursor: pointer;
  z-index: 10;
  padding: 5rpx 0;
}
.collapse-arrow-icon {
  margin-left: 10rpx;
  transition: transform 300ms ease;
  transform: rotate(-90deg);
}
.collapse-arrow-icon.rotated {
  transform: rotate(0deg);
}
.collapse-arrow-icon text {
  font-size: 24rpx;
  color: #999;
}
.collapse-content {
  overflow: hidden;
  max-height: 0;
  transition: max-height 300ms ease;
}
.collapse-content.expanded {
  max-height: 200rpx; /* 足够的最大高度 */
}
.collapse-text {
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 0 20rpx 0;
  display: block;
}
