
.vehicle-list-container.data-v-6517cfe0 {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.card-list.data-v-6517cfe0 {
  padding-bottom: 150rpx; /* 为底部按钮留出空间 */
}
.vehicle-card.data-v-6517cfe0 {
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}
.card-main.data-v-6517cfe0 {
    position: relative;
    padding: 24rpx;
}
.type-tag.data-v-6517cfe0 {
  position: absolute;
  top: 0;
  right: 0;
  background-color: #e6f7f2;
  color: #00c777;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  border-radius: 0 16rpx 0 16rpx;
}
.plate-number.data-v-6517cfe0 {
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  padding: 32rpx 0;
}
.separator.data-v-6517cfe0 {
  height: 1rpx;
  background-color: #f0f0f0;
}
.card-footer.data-v-6517cfe0 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
}
.default-option.data-v-6517cfe0 {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #999;
}
.default-text-active.data-v-6517cfe0 {
    color: #007AFF;
}
.radio-btn.data-v-6517cfe0 {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-right: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
}
.radio-btn.checked.data-v-6517cfe0 {
  background-color: #007AFF;
  border-color: #007AFF;
  color: white;
}
.more-actions.data-v-6517cfe0 {
  font-size: 28rpx;
  color: #666;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 操作面板 */
.actions-panel.data-v-6517cfe0 {
  display: flex;
  background-color: #f7f7f7;
}
.action-btn.data-v-6517cfe0 {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  color: white;
  font-size: 28rpx;
}
.delete-btn.data-v-6517cfe0 {
  background-color: #f01f1f;
}
.edit-btn.data-v-6517cfe0 {
  background-color: #007aff;
}

/* 添加按钮 */
.add-vehicle-button.data-v-6517cfe0 {
  position: fixed;
  bottom: 32rpx;
  left: 5%;
  width: 90%;
  background-color: #007aff;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
}
.plus-icon.data-v-6517cfe0 {
  font-size: 40rpx;
  margin-right: 16rpx;
}

/* 弹窗样式 */
.popup-container.data-v-6517cfe0 {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.popup-header.data-v-6517cfe0 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.popup-title.data-v-6517cfe0 {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.close-btn.data-v-6517cfe0 {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}
.popup-content.data-v-6517cfe0 {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}
.button-container.data-v-6517cfe0 {
  display: flex;
  margin-top: 40rpx;
  /* flex: 1; */
  justify-content: space-between;
}
