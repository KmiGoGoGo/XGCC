
.page-container.data-v-446caae6 {
  background-color: #f5f9ff;
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 可滚动内容区域 */
.scroll-content.data-v-446caae6 {
  flex: 1;
  overflow-y: auto;
}
.main-content.data-v-446caae6 {
  min-height: 100%;
}

/* 顶部标题 */
.header.data-v-446caae6 {
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #333;
  background: #e9f1ff;
  border-radius: 24rpx 24rpx 0 0;
  font-weight: 500;
}
.highlight-text.data-v-446caae6 {
  color: #1a73e8;
  font-weight: bold;
}

/* 优惠券列表 */
.coupon-list.data-v-446caae6 {
  padding: 20rpx;
  padding-bottom: 0;
}

/* 优惠券卡片基础样式 */
.coupon-card.data-v-446caae6 {
  display: flex;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 已选中样式 */
.selected.data-v-446caae6 {
  border: 2rpx solid #1a73e8;
}

/* 未选中样式 */
.unselected.data-v-446caae6 {
  opacity: 0.6;
}

/* 左侧金额区 */
.coupon-left.data-v-446caae6 {
  position: relative;
  width: 200rpx;
  background: #e6f0ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #1a73e8;
  font-weight: bold;
}
.unselected-left.data-v-446caae6 {
  background: #f1f3f6;
  color: #9ea7b5;
}

/* 金额符号和数字 */
.currency-symbol.data-v-446caae6 {
  font-size: 32rpx;
  vertical-align: top;
}
.coupon-amount.data-v-446caae6 {
  font-size: 64rpx;
  line-height: 1;
}
.coupon-type.data-v-446caae6 {
  margin-top: 6rpx;
  font-size: 26rpx;
}

/* 装饰圆角切割 */
.circle-decoration.data-v-446caae6 {
  position: absolute;
  left: -12rpx;
  width: 24rpx;
  height: 24rpx;
  background: #f5f9ff;
  border-radius: 50%;
  z-index: 2;
}
.circle-decoration.top.data-v-446caae6 {
  top: 10rpx;
}
.circle-decoration.bottom.data-v-446caae6 {
  bottom: 10rpx;
}

/* 右侧信息区 */
.coupon-right.data-v-446caae6 {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
}

/* 文本信息 */
.coupon-info.data-v-446caae6 {
  flex: 1;
}
.coupon-title.data-v-446caae6 {
  font-size: 32rpx;
  color: #222;
  font-weight: bold;
}
.coupon-condition.data-v-446caae6 {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}
.coupon-dates.data-v-446caae6 {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: flex;
  flex-direction: column;
}

/* 选中圆圈 */
.check-icon.data-v-446caae6 {
  width: 48rpx;
  height: 48rpx;
  background: #1a73e8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.check-mark.data-v-446caae6 {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

/* 空圆圈（未选） */
.empty-circle.data-v-446caae6 {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
}

/* 禁用状态圆圈 */
.disabled-circle.data-v-446caae6 {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #e0e0e0;
}

/* 不可用提示 */
.status-desc.data-v-446caae6 {
  margin-top: -12rpx;
  margin-bottom: 12rpx;
  padding: 0 20rpx;
}
.desc.data-v-446caae6 {
  font-size: 24rpx;
  color: #999;
}

/* 底部占位，防止内容被遮挡 */
.bottom-safe-area.data-v-446caae6 {
  height: 40rpx;
}

/* 固定底部区域 */
.footer.data-v-446caae6 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 999;
}
.footer-content.data-v-446caae6 {
  padding: 20rpx 32rpx;
}
.footer-text.data-v-446caae6 {
  font-size: 26rpx;
  color: #444;
}
.footer-highlight.data-v-446caae6 {
  color: #1a73e8;
  font-weight: bold;
}
.footer-subtext.data-v-446caae6 {
  color: #888;
}

/* 按钮样式 */
.confirm-button.data-v-446caae6 {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1a73e8 0%, #1877ff 100%);
  color: #fff;
  border-radius: 44rpx;
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 12rpx rgba(26, 115, 232, 0.3);
}
.confirm-button.data-v-446caae6:active {
  opacity: 0.9;
}

/* 底部安全区域 */
.safe-area-inset-bottom.data-v-446caae6 {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
  background: #fff;
}

/* 无优惠券提示 */
.no-coupon.data-v-446caae6 {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
  min-height: 100vh;
}
