
.container.data-v-f4f12eb7 {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 16rpx;
}
.coupon-list.data-v-f4f12eb7 {
  padding-bottom: 120rpx; /* 为底部tab留出空间 */
}
.coupon-item.data-v-f4f12eb7 {
  display: flex;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}
.left-section.data-v-f4f12eb7 {
  background-color: #FF7F00;
  color: white;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
}
.price-section.data-v-f4f12eb7 {
  display: flex;
  align-items: baseline;
}
.currency.data-v-f4f12eb7 {
  font-size: 32rpx;
}
.amount.data-v-f4f12eb7 {
  font-size: 56rpx;
  font-weight: bold;
}
.coupon-type.data-v-f4f12eb7 {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.usage-scope.data-v-f4f12eb7 {
  font-size: 20rpx;
  margin-top: 4rpx;
}
.right-section.data-v-f4f12eb7 {
  background-color: white;
  padding: 24rpx;
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.info-section.data-v-f4f12eb7 {
  display: flex;
  flex-direction: column;
}
.title.data-v-f4f12eb7 {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.usage-condition.data-v-f4f12eb7 {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.date-time.data-v-f4f12eb7 {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.site-link.data-v-f4f12eb7 {
  margin-top: 16rpx;
  padding: 8rpx 0;
}
.site-link text.data-v-f4f12eb7 {
  font-size: 24rpx;
  color: #999;
}
.button-section.data-v-f4f12eb7 {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 16rpx;
}
.use-card-btn.data-v-f4f12eb7 {
  width: 120rpx !important;
  height: 60rpx !important;
}
.bottom-tabs.data-v-f4f12eb7 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: white;
  padding: 24rpx 0;
  border-top: 1rpx solid #eee;
}
.tab-item.data-v-f4f12eb7 {
  font-size: 32rpx;
  color: #999;
  margin: 0 40rpx;
}
.tab-item.active.data-v-f4f12eb7 {
  color: #333;
  font-weight: bold;
}

/* 确认模态框样式 */
.confirm-content.data-v-f4f12eb7 {
  padding: 32rpx;
  text-align: center;
}
.confirm-content text.data-v-f4f12eb7 {
  font-size: 32rpx;
  color: #333;
  line-height: 1.5;
}
