  align-items: center;
  padding: 16rpx;
  background-color: white;
  border-radius: 16rpx;
}
.tabs.data-v-9aee1992 {
  display: flex;
  gap: 16rpx;
}
.tab-item.data-v-9aee1992 {
  padding: 12rpx 24rpx;
