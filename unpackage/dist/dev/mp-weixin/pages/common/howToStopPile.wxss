
page {
  background-color: #f4f6f8;
  height: 100vh;
  padding-bottom: 40rpx;
}
.stopCon {
  background: linear-gradient(0deg, #ffffff, #f4f6f8);
  box-shadow: 4rpx 7rpx 20rpx 0rpx rgba(166, 171, 179, 0.24);
  border: 2rpx solid #ffffff;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  padding: 40rpx 40rpx;
}
.title {
  font-size: 34rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #18181a;
}
.textCon {
  font-size: 28rpx;
  font-weight: 400;
  color: #606266;
  margin-top: 15rpx;
}
.img {
  width: 100%;
  height: 350rpx;
  margin: 24rpx 0;
}
.orderClothes {
  font-weight: 400;
  color: #606266;
  font-size: 24rpx;
  text-align: center;
  padding: 40rpx 0;
}
.orderClothesText {
  color: #007AFF; /* 使用蓝色作为默认主色调 */
}
.textRed {
  color: #FC724C;
}
